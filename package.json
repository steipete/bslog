{
  "name": "@steipete/bslog",
  "version": "1.4.0",
  "description": "Better Stack log query CLI with GraphQL-inspired syntax",
  "keywords": [
    "betterstack",
    "cli",
    "graphql",
    "logging",
    "logs",
    "query"
  ],
  "homepage": "https://github.com/steipete/bslog#readme",
  "bugs": {
    "url": "https://github.com/steipete/bslog/issues"
  },
  "license": "MIT",
  "author": "steipete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steipete/bslog.git"
  },
  "bin": {
    "bslog": "dist/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/bslog",
    "build:npm": "bun build ./src/index.ts --target node --outfile dist/index.js && chmod +x dist/index.js",
    "test": "bun test",
    "test:unit": "bun test src/__tests__/unit",
    "test:integration": "bun test src/__tests__/integration",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "type-check": "tsgo --noEmit",
    "prepublishOnly": "bun run test && bun run build:npm",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run format:check && oxlint --deny-warnings src",
    "lint:fix": "bun run format && oxlint --fix src"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.2.22"
}
